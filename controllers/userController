const userModel = require('../models/user.js');
const bcrypt = require('bcrypt');
const sendEmail = require('../utils/email.js');
const otp_generator = require('otp-generator');
const jwt = require('jsonwebtoken');

exports.signUp = async (req, res) => {
    try {
        const { fullName, email, gender, password, age } = req.body;

        const user = await userModel.findOne({email: email.toLowerCase()});

        if (user) {
            return res.status(400).json({
                message: `User with Email: ${email} already exist`
            })

            
        }
        const saltedRounds = await bcrypt.genSalt(10)
        const hashedPassword = await bcrypt.hash(password, saltedRounds)

        const otp = otp_generator.generate(6, {lowerCaseAlphabets: false, upperCaseAlphabets: false, specialChars: false})

        const data = {
            fullName,
            email: email.toLowerCase(),
            gender,
            password: hashedPassword,
            age,
            otp
        }


        const newUser = await userModel.create(data);

        const emailContent = {
            name: newUser.fullName,
            email: newUser.email,
            subject: 'Welcome to Zanzibar',
            htmlContent: `htmlContent":"<html><head></head><body><p>Hello, ${newUser.fullName}</p>We are thrilled to have you onboard, Please use the OTP below to verify your account. <br>${otp} </p></body></html>`
        }

        await sendEmail(emailContent)

        res.status(201).json({
            message: 'User Created Successfully',
            data: newUser
        })

    } catch (error) {
        res.status(500).json({
            message: error.message
        })
    }
}

